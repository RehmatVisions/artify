{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "env": {
    "VERCEL_ENV": "production"
  },
  "images": {
    "domains": [
      "images.unsplash.com",
      "localhost"
    ],
    "formats": [
      "image/webp",
      "image/avif"
    ],
    "minimumCacheTTL": 31536000
  },
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.webp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/webp"
        }
      ]
    }
  ]
}
