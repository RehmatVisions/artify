{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "env": {
    "VERCEL_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/i.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*"
    }
  ],
  "images": {
    "domains": [
      "images.unsplash.com",
      "localhost"
    ],
    "formats": [
      "image/webp",
      "image/avif"
    ],
    "sizes": [320, 640, 1024, 1280, 1536],
    "minimumCacheTTL": 31536000
  },
  "headers": [
    {
      "source": "/assets/portfolio/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.webp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/webp"
        }
      ]
    }
  ]
}
